#!/usr/bin/env python3
"""
launch_campaign.py - Lance une campagne de benchmarks sur Grid5000

Ce script soumet des jobs OAR pour différentes configurations de nœuds
afin de valider le modèle théorique de performance.

Usage:
    python3 launch_campaign.py
"""

import subprocess
import os
import sys
from datetime import datetime

# === CONFIGURATION ===
TARGET_CLUSTER = "nova"  # Cluster cible (nova, dahu, gros, etc.)
NODE_COUNTS = [2, 3, 4, 6, 8, 10, 12, 15, 18]  # Différentes valeurs de n
WALLTIME = "01:00:00"  # Durée max par job
ITERATIONS = 3  # Répétitions par configuration

# Chemins
PROJECT_DIR = os.path.expanduser("~/Distributed-Make/Makefile")
SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
BENCHMARK_SCRIPT = os.path.join(SCRIPT_DIR, "benchmark_model.sh")
DATA_DIR = os.path.join(PROJECT_DIR, "performances", "data")


def check_prerequisites():
    """Vérifie que tout est en place"""
    errors = []

    # Vérifier le script de benchmark
    if not os.path.exists(BENCHMARK_SCRIPT):
        errors.append(f"Script introuvable - {BENCHMARK_SCRIPT}")

    # Vérifier qu'on est sur Grid5000
    hostname = subprocess.getoutput("hostname")
    if "grid5000" not in hostname and "g5k" not in hostname:
        print(f"⚠Attention: hostname={hostname} - êtes-vous sur Grid5000?")

    # Vérifier oarsub
    result = subprocess.run(["which", "oarsub"], capture_output=True)
    if result.returncode != 0:
        errors.append("oarsub non trouvé - êtes-vous sur un frontend Grid5000?")

    return errors


def submit_job(node_count: int) -> str:
    """Soumet un job OAR pour un nombre de nœuds donné"""

    job_name = f"bench_{node_count}nodes"

    # Commande OAR
    oar_cmd = [
        "oarsub",
        "-l", f"nodes={node_count},walltime={WALLTIME}",
        "-p", f"cluster='{TARGET_CLUSTER}'",
        "-n", job_name,
        f"bash {BENCHMARK_SCRIPT} {ITERATIONS}"
    ]

    try:
        result = subprocess.run(oar_cmd, capture_output=True, text=True, timeout=30)
        if result.returncode == 0:
            # Extraire le job ID
            for line in result.stdout.split('\n'):
                if "OAR_JOB_ID" in line:
                    job_id = line.split('=')[1].strip()
                    return job_id
            return "submitted"
        else:
            return f"ERREUR: {result.stderr}"
    except subprocess.TimeoutExpired:
        return "TIMEOUT"
    except Exception as e:
        return f"EXCEPTION: {e}"


def main():
    print("╗")
    print("  CAMPAGNE DE VALIDATION MODÈLE THÉORIQUE                ")
    print("╝")
    print(f"  Cluster cible: {TARGET_CLUSTER}")
    print(f"  Configurations: {NODE_COUNTS}")
    print(f"  Itérations par config: {ITERATIONS}")
    print(f"  Script: {BENCHMARK_SCRIPT}")
    print("" * 62)

    # Vérifications
    errors = check_prerequisites()
    if errors:
        for err in errors:
            print(f" ERREUR: {err}")
        sys.exit(1)

    # Rendre le script exécutable
    os.chmod(BENCHMARK_SCRIPT, 0o755)

    # Créer le répertoire de données
    os.makedirs(DATA_DIR, exist_ok=True)

    # Soumettre les jobs
    print("\n Soumission des jobs:\n")
    submitted_jobs = []

    for n in NODE_COUNTS:
        print(f"  Soumission pour {n:2d} nœuds... ", end="", flush=True)
        result = submit_job(n)

        if "ERREUR" in result or "EXCEPTION" in result:
            print(f" {result}")
        else:
            print(f" Job {result}")
            submitted_jobs.append((n, result))

    # Résumé
    print("\n" + "" * 62)
    print("╗")
    print("  CAMPAGNE LANCÉE                                        ")
    print("╝")
    print(f"  Jobs soumis: {len(submitted_jobs)}/{len(NODE_COUNTS)}")
    print(f"  Temps estimé: ~{len(NODE_COUNTS) * 30} minutes")
    print()
    print("   Surveillance:")
    print("     oarstat -u $USER")
    print("     watch -n 30 'oarstat -u $USER'")
    print()
    print("   Résultats:")
    print(f"     {DATA_DIR}/raw_measurements.csv")
    print()

    # Sauvegarder la liste des jobs
    jobs_file = os.path.join(DATA_DIR, f"campaign_{datetime.now():%Y%m%d_%H%M%S}.txt")
    with open(jobs_file, 'w') as f:
        f.write(f"# Campagne lancée le {datetime.now()}\n")
        f.write(f"# Cluster: {TARGET_CLUSTER}\n")
        f.write(f"# Configurations: {NODE_COUNTS}\n\n")
        for n, job_id in submitted_jobs:
            f.write(f"{n} nodes: {job_id}\n")

    print(f"   Log: {jobs_file}")


if __name__ == "__main__":
    main()
